{
	"name": "@expcluster/auto-restart",
	"version": "7.0.4",
	"description": "Clusterio plugin restarting hosts and the controller once no players are online.",
	"author": "Cooldude2606 <https://github.com/Cooldude2606>",
	"license": "MIT",
	"repository": "explosivegaming/ExpCluster",
	"type": "module",
	"main": "dist/node/index.js",
	"scripts": {
		"prepare": "tsc --build && vite build",
		"test": "tap --type-strip-only --disable-coverage --allow-empty-coverage test/*.test.js",
		"coverage": "tap --coverage-report=text test/*.test.js"
	},
	"engines": {
		"node": ">=22"
	},
	"peerDependencies": {
		"@clusterio/controller": "workspace:^",
		"@clusterio/lib": "workspace:^"
	},
	"peerDependenciesMeta": {
		"@clusterio/controller": {
			"optional": true
		}
	},
	"devDependencies": {
		"@clusterio/controller": "workspace:^",
		"@clusterio/lib": "workspace:^",
		"@clusterio/web_ui": "workspace:^",
		"@types/node": "catalog:",
		"tap": "^21.1.0",
		"typescript": "catalog:",
		"vite": "catalog:"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"clusterio",
		"clusterio-plugin",
		"factorio"
	]
}
